# OpenAI API
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4

# Google Calendar
CALENDAR_ID=your-calendar-id@group.calendar.google.com
# Descarcă credentials.json din Google Cloud Console și pune-l în root directory

# Email (Gmail SMTP)
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password-here
# Folosește App Password dacă ai 2FA activat: https://support.google.com/accounts/answer/185833

# WhatsApp
WHATSAPP_QR_TIMEOUT=60
WHATSAPP_PHONE_NUMBER=+40123456789

# Notificări
NOTIFICATION_TIME=09:00
NOTIFICATION_TIMEZONE=Europe/Bucharest

# Logging
LOG_LEVEL=INFO
